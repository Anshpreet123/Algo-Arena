# --- Database -------------------------------------------------------------
DATABASE_URL="postgres://postgres:supersecurepassword@localhost:5432/algo-arena?schema=public"

# --- Auth -----------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production
JWT_SECRET=change-me-in-production

# --- Judge (apps/judge) ---------------------------------------------------
JUDGE_URL=http://localhost:4000
# Shared secret; must match JUDGE_TOKEN in apps/judge/.env. Blank = no auth.
JUDGE_TOKEN=
JUDGE_TIME_LIMIT_MS=5000

# --- Problems on disk -----------------------------------------------------
# Absolute path to apps/problems. Leave unset to resolve it relative to apps/web.
# MOUNT_PATH=/absolute/path/to/Algo-Arena/apps/problems

# --- Rate limiting (optional) ---------------------------------------------
# Unset means rate limiting is disabled rather than blocking every request.
REDIS_URL=redis://:supersecurepassword@localhost:6379

# --- AI features (optional) -----------------------------------------------
# Unset means hints/review/explain return an honest "not configured" message.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Bot check (optional) -------------------------------------------------
# Unset means the Turnstile check is skipped entirely.
CLOUDFLARE_TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
